+package com.margelo.nitro.nitroplayer.musicfree
+
+import androidx.media3.extractor.Extractor
+import com.margelo.nitro.nitroplayer.BuildConfig
+
+internal object MusicFreeAudioExtractorRegistry {
+    fun factories(): List<() -> Extractor> {
+        val factories = mutableListOf<() -> Extractor>(::DsfExtractor)
