+package com.margelo.nitro.nitroplayer.musicfree
+
+import java.io.IOException
+
+internal object AsfWmaPacketParser {
+    fun parse(
+        packet: ByteArray,
+        declaredPacketSize: Int,
+        audioStreamNumber: Int,
+    ): AsfWmaPacket {
+        val packetSize =
+            when {
+                declaredPacketSize > 0 -> declaredPacketSize
+                else -> packet.size
+            }
+        if (packetSize <= 0 || packetSize > packet.size) {
+            throw IOException("Invalid ASF packet size.")
+        }
+
+        val cursor = AsfPacketCursor(packet, packetSize)
+        val errorCorrectionFlags = cursor.readUnsignedByte()
+        cursor.skip(errorCorrectionDataLength(errorCorrectionFlags))
+
+        val lengthTypeFlags = cursor.readUnsignedByte()
+        val propertyFlags = cursor.readUnsignedByte()
+
+        val packetLength =
+            cursor.readVariableLength(
+                (lengthTypeFlags and PACKET_LENGTH_TYPE_MASK) ushr PACKET_LENGTH_TYPE_SHIFT,
+            )
+        val sequence =
+            cursor.readVariableLength(
+                (lengthTypeFlags and SEQUENCE_LENGTH_TYPE_MASK) ushr SEQUENCE_LENGTH_TYPE_SHIFT,
+            )
+        val paddingLength =
+            cursor.readVariableLength(
+                (lengthTypeFlags and PADDING_LENGTH_TYPE_MASK) ushr PADDING_LENGTH_TYPE_SHIFT,
+            )
+        val sendTimeMs = cursor.readLittleEndianUnsignedInt()
+        val durationMs = cursor.readLittleEndianUnsignedShort()
+
+        val actualPacketLength =
+            when {
+                packetLength > 0 -> packetLength.toInt()
+                else -> packetSize
+            }
+        if (actualPacketLength > packetSize) {
+            throw IOException("ASF packet length exceeds available packet bytes.")
+        }
+        val payloadEnd = actualPacketLength - paddingLength.toInt()
+        if (payloadEnd < cursor.position || payloadEnd > actualPacketLength) {
+            throw IOException("Invalid ASF packet padding length.")
+        }
+
+        val streamNumberLengthType =
+            (propertyFlags and STREAM_NUMBER_LENGTH_TYPE_MASK) ushr STREAM_NUMBER_LENGTH_TYPE_SHIFT
+        val mediaObjectNumberLengthType =
+            (propertyFlags and MEDIA_OBJECT_NUMBER_LENGTH_TYPE_MASK) ushr
+                MEDIA_OBJECT_NUMBER_LENGTH_TYPE_SHIFT
+        val offsetIntoMediaObjectLengthType =
+            (propertyFlags and OFFSET_INTO_MEDIA_OBJECT_LENGTH_TYPE_MASK) ushr
+                OFFSET_INTO_MEDIA_OBJECT_LENGTH_TYPE_SHIFT
+        val replicatedDataLengthType =
+            (propertyFlags and REPLICATED_DATA_LENGTH_TYPE_MASK) ushr
+                REPLICATED_DATA_LENGTH_TYPE_SHIFT
+
+        val hasMultiplePayloads = (lengthTypeFlags and MULTIPLE_PAYLOADS_PRESENT) != 0
+        val payloadCount: Int
+        val payloadLengthType: Int
+        if (hasMultiplePayloads) {
+            val payloadFlags = cursor.readUnsignedByte()
+            payloadCount = payloadFlags and PAYLOAD_COUNT_MASK
+            payloadLengthType =
+                (payloadFlags and PAYLOAD_LENGTH_TYPE_MASK) ushr PAYLOAD_LENGTH_TYPE_SHIFT
+        } else {
+            payloadCount = 1
+            payloadLengthType = LENGTH_TYPE_ABSENT
+        }
+
+        if (payloadCount <= 0) {
+            throw IOException("ASF packet does not contain payloads.")
+        }
+
+        val payloads = mutableListOf<AsfWmaPayload>()
+        repeat(payloadCount) {
+            val streamNumberRaw = cursor.readVariableLength(streamNumberLengthType).toInt()
+            val mediaObjectNumber = cursor.readVariableLength(mediaObjectNumberLengthType)
+            val offsetIntoMediaObject = cursor.readVariableLength(offsetIntoMediaObjectLengthType)
+            val replicatedDataLength = cursor.readVariableLength(replicatedDataLengthType).toInt()
+            val replicatedData = cursor.readBytes(replicatedDataLength)
+
+            val payloadDataLength =
+                if (hasMultiplePayloads) {
+                    cursor.readVariableLength(payloadLengthType).toInt()
+                } else {
+                    payloadEnd - cursor.position
+                }
+            if (payloadDataLength < 0 || cursor.position + payloadDataLength > payloadEnd) {
+                throw IOException("Invalid ASF payload data length.")
+            }
+
+            val streamNumber = streamNumberRaw and STREAM_NUMBER_MASK
+            val payloadData = cursor.readBytes(payloadDataLength)
+            payloads.add(
+                AsfWmaPayload(
+                    streamNumber = streamNumber,
+                    encrypted = (streamNumberRaw and ENCRYPTED_STREAM_FLAG) != 0,
+                    mediaObjectNumber = mediaObjectNumber,
+                    offsetIntoMediaObject = offsetIntoMediaObject,
+                    replicatedData = replicatedData,
+                    mediaObjectSize = replicatedData.readLittleEndianUnsignedIntOrNull(0),
+                    presentationTimeMs = replicatedData.readLittleEndianUnsignedIntOrNull(4),
+                    presentationTimeDeltaMs = replicatedData.readUnsignedByteOrNull(0),
+                    payloadData = payloadData,
+                    targetAudioStream = streamNumber == audioStreamNumber,
+                    compressedPayload = replicatedDataLength == COMPRESSED_PAYLOAD_REPLICATED_DATA_LENGTH,
+                ),
+            )
+        }
+
+        return AsfWmaPacket(
+            sequence = sequence,
+            sendTimeMs = sendTimeMs,
+            durationMs = durationMs,
+            paddingLength = paddingLength,
+            payloads = payloads,
+        )
+    }
+
+    private fun errorCorrectionDataLength(errorCorrectionFlags: Int): Int =
+        if ((errorCorrectionFlags and ERROR_CORRECTION_PRESENT) == 0) {
+            0
+        } else {
+            errorCorrectionFlags and ERROR_CORRECTION_DATA_LENGTH_MASK
+        }
+
+    private const val ERROR_CORRECTION_PRESENT = 0x80
+    private const val ERROR_CORRECTION_DATA_LENGTH_MASK = 0x0f
+
+    private const val MULTIPLE_PAYLOADS_PRESENT = 0x01
+    private const val SEQUENCE_LENGTH_TYPE_MASK = 0x06
+    private const val SEQUENCE_LENGTH_TYPE_SHIFT = 1
+    private const val PADDING_LENGTH_TYPE_MASK = 0x18
+    private const val PADDING_LENGTH_TYPE_SHIFT = 3
+    private const val PACKET_LENGTH_TYPE_MASK = 0x60
+    private const val PACKET_LENGTH_TYPE_SHIFT = 5
+
+    private const val REPLICATED_DATA_LENGTH_TYPE_MASK = 0x03
+    private const val REPLICATED_DATA_LENGTH_TYPE_SHIFT = 0
+    private const val OFFSET_INTO_MEDIA_OBJECT_LENGTH_TYPE_MASK = 0x0c
+    private const val OFFSET_INTO_MEDIA_OBJECT_LENGTH_TYPE_SHIFT = 2
+    private const val MEDIA_OBJECT_NUMBER_LENGTH_TYPE_MASK = 0x30
+    private const val MEDIA_OBJECT_NUMBER_LENGTH_TYPE_SHIFT = 4
+    private const val STREAM_NUMBER_LENGTH_TYPE_MASK = 0xc0
+    private const val STREAM_NUMBER_LENGTH_TYPE_SHIFT = 6
+
+    private const val PAYLOAD_COUNT_MASK = 0x3f
+    private const val PAYLOAD_LENGTH_TYPE_MASK = 0xc0
+    private const val PAYLOAD_LENGTH_TYPE_SHIFT = 6
+
+    private const val LENGTH_TYPE_ABSENT = 0
+    private const val STREAM_NUMBER_MASK = 0x7f
+    private const val ENCRYPTED_STREAM_FLAG = 0x80
+    private const val COMPRESSED_PAYLOAD_REPLICATED_DATA_LENGTH = 1
+}
