+        val sampleRate = payload.readLittleEndianInt(16)
+        val bitsPerSample = payload.readLittleEndianInt(20)
+        val sampleCount = payload.readLittleEndianLong(24)
+        val blockSizePerChannel = payload.readLittleEndianInt(32)
