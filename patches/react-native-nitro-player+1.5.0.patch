+package com.margelo.nitro.nitroplayer.musicfree
+
+import android.content.Context
+import android.net.Uri
+import androidx.media3.datasource.DataSpec
+import androidx.media3.datasource.DefaultDataSource
+import androidx.media3.datasource.DefaultHttpDataSource
+import androidx.media3.datasource.ResolvingDataSource
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.RenderersFactory
+import androidx.media3.exoplayer.source.DefaultMediaSourceFactory
+import androidx.media3.exoplayer.source.MediaSource
+import androidx.media3.extractor.DefaultExtractorsFactory
+import androidx.media3.extractor.ExtractorsFactory
+import com.margelo.nitro.nitroplayer.TrackItem
+import java.util.concurrent.ConcurrentHashMap
+import org.json.JSONObject
+
+internal object MusicFreePlayerExtensions {
+    private const val EXTRA_HEADERS_JSON = "musicfreeHeadersJson"
+    private const val EXTRA_USER_AGENT = "musicfreeUserAgent"
+    private const val USER_AGENT_HEADER = "User-Agent"
+
+    private val requestHeadersByUrl = ConcurrentHashMap<String, Map<String, String>>()
+    private val requestHeadersByOrigin = ConcurrentHashMap<String, Map<String, String>>()
+
+    fun createRenderersFactory(context: Context): RenderersFactory {
+        MusicFreeAudioFormatRegistry.registerCustomMimeTypes()
+        return DefaultRenderersFactory(context)
+            .setExtensionRendererMode(
+                DefaultRenderersFactory.EXTENSION_RENDERER_MODE_PREFER,
+            )
+    }
+
+    fun createMediaSourceFactory(context: Context): MediaSource.Factory {
+        MusicFreeAudioFormatRegistry.registerCustomMimeTypes()
+        // Media3's own HTTP stack again. The MusicFree-controlled DataSource was
+        // reverted on 2026-07-26: it sat in the default playback hot path while
+        // the hole it claimed to close (a plugin reaching a private address) is
+        // reachable anyway, since plugin code runs in the app's own JS realm.
+        val resolvingDataSourceFactory =
+            ResolvingDataSource.Factory(DefaultHttpDataSource.Factory()) { dataSpec ->
+                resolveRequestHeaders(dataSpec)
+            }
+        val dataSourceFactory =
+            DefaultDataSource.Factory(context, resolvingDataSourceFactory)
+
+        return DefaultMediaSourceFactory(dataSourceFactory, createExtractorsFactory())
+    }
+
+    fun createExtractorsFactory(): ExtractorsFactory =
+        MusicFreeExtractorsFactory(
+            delegate = DefaultExtractorsFactory(),
+            extensionFactories = MusicFreeAudioExtractorRegistry.factories(),
+        )
+
+    fun registerTrackRequest(
+        track: TrackItem,
+        effectiveUrl: String,
+    ) {
+        val headers = buildRequestHeaders(track)
+        if (headers.isEmpty() || effectiveUrl.isBlank()) {
+            return
+        }
+
+        requestHeadersByUrl[effectiveUrl] = headers
+        originKey(Uri.parse(effectiveUrl))?.let { origin ->
+            requestHeadersByOrigin[origin] = headers
+        }
+    }
+
+    fun clearRequestHeaders() {
+        requestHeadersByUrl.clear()
+        requestHeadersByOrigin.clear()
+    }
+
+    private fun resolveRequestHeaders(dataSpec: DataSpec): DataSpec {
+        val uri = dataSpec.uri
+        val headers =
+            requestHeadersByUrl[uri.toString()]
+                ?: originKey(uri)?.let { origin -> requestHeadersByOrigin[origin] }
+                ?: return dataSpec
+
+        return if (headers.isEmpty()) dataSpec else dataSpec.withAdditionalHeaders(headers)
+    }
+
+    private fun buildRequestHeaders(track: TrackItem): Map<String, String> {
+        val payload = track.extraPayload?.toHashMap() ?: return emptyMap()
+        val headers = linkedMapOf<String, String>()
+
+        parseHeadersJson(payload[EXTRA_HEADERS_JSON] as? String).forEach { (key, value) ->
+            headers[key] = value
+        }
+        parseHeadersMap(payload["headers"]).forEach { (key, value) ->
+            headers[key] = value
+        }
+
+        val userAgent = (payload[EXTRA_USER_AGENT] as? String)?.takeIf { it.isNotBlank() }
+        if (userAgent != null && headers.keys.none { it.equals(USER_AGENT_HEADER, ignoreCase = true) }) {
+            headers[USER_AGENT_HEADER] = userAgent
+        }
+
+        return headers
+    }
+
+    private fun parseHeadersJson(headersJson: String?): Map<String, String> {
+        if (headersJson.isNullOrBlank()) {
+            return emptyMap()
+        }
+
+        return try {
+            val json = JSONObject(headersJson)
+            val headers = linkedMapOf<String, String>()
+            val keys = json.keys()
+            while (keys.hasNext()) {
+                val key = keys.next()
+                if (key.isBlank() || json.isNull(key)) {
+                    continue
+                }
+                val value = json.optString(key)
+                if (value.isNotEmpty()) {
+                    headers[key] = value
+                }
+            }
+            headers
+        } catch (_: Exception) {
+            emptyMap()
+        }
+    }
+
+    private fun parseHeadersMap(headersRaw: Any?): Map<String, String> {
+        val rawMap = headersRaw as? Map<*, *> ?: return emptyMap()
+        val headers = linkedMapOf<String, String>()
+        rawMap.forEach { (key, value) ->
+            val headerName = key as? String ?: return@forEach
+            if (headerName.isBlank() || value == null) {
+                return@forEach
+            }
+            val headerValue = value as? String ?: value.toString()
+            if (headerValue.isNotEmpty()) {
+                headers[headerName] = headerValue
+            }
+        }
+        return headers
+    }
+
+    private fun originKey(uri: Uri): String? {
+        val scheme = uri.scheme ?: return null
+        val host = uri.host ?: return null
+        val port = uri.port
+        return if (port >= 0) {
+            "$scheme://$host:$port"
+        } else {
+            "$scheme://$host"
+        }
+    }
+}
