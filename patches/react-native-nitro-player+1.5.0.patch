+                    )
+            }
+        val dsdChunkSize = dsdHeader.readLittleEndianLong(4)
+        if (header.matchesAscii("DSD ")) {
+            skipFullyLong(input, payloadSize(dsdChunkSize))
+        } else {
+            val bytesToFirstChunkEnd = dsdChunkSize - input.position
+            if (bytesToFirstChunkEnd < 0) {
+                throw IOException(
+                    "Invalid DSF input position ${input.position} after sniffed header ${dsdHeader.toHex()}",
+                )
+            }
+            skipFullyLong(input, bytesToFirstChunkEnd)
+        }
+
+        var format: DsfFormat? = null
+        while (true) {
+            if (!input.readFully(header, 0, header.size, true)) {
+                throw EOFException("Missing DSF data chunk.")
+            }
+
+            val chunkPayloadSize = payloadSize(header.readLittleEndianLong(4))
