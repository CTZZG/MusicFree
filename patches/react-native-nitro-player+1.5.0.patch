+                .setSampleMimeType(parsedAudioStream.sampleMimeType)
+                .setCodecs(parsedAudioStream.codecName)
+                .setChannelCount(parsedAudioStream.channelCount)
+                .setSampleRate(parsedAudioStream.sampleRate)
+                .setAverageBitrate(max(0, parsedAudioStream.averageBytesPerSecond) * BITS_PER_BYTE)
