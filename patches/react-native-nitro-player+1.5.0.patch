+package com.margelo.nitro.nitroplayer.musicfree
+
+import androidx.media3.common.C
+import androidx.media3.common.MimeTypes
+import java.util.concurrent.atomic.AtomicBoolean
+
+internal object MusicFreeAudioFormatRegistry {
+    const val MIME_DSF = "audio/x-dsf"
+    const val MIME_WMA = "audio/x-ms-wma"
+    const val MIME_WMA_V1 = "audio/x-ms-wma-v1"
+    const val MIME_WMA_V2 = "audio/x-ms-wma-v2"
+    const val MIME_WMA_PRO = "audio/x-ms-wmapro"
+    const val MIME_WMA_LOSSLESS = "audio/x-ms-wmalossless"
+    const val MIME_WMA_VOICE = "audio/x-ms-wmavoice"
+
+    const val CODEC_DSF = "dsd_lsbf_planar"
+    const val CODEC_WMAV1 = "wmav1"
+    const val CODEC_WMAV2 = "wmav2"
+    const val CODEC_WMAPRO = "wmapro"
+    const val CODEC_WMALOSSLESS = "wmalossless"
+    const val CODEC_WMAVOICE = "wmavoice"
+
+    private val registered = AtomicBoolean(false)
+
+    fun registerCustomMimeTypes() {
+        if (!registered.compareAndSet(false, true)) {
+            return
+        }
+
+        MimeTypes.registerCustomMimeType(
+            MIME_DSF,
+            CODEC_DSF,
+            C.TRACK_TYPE_AUDIO,
+        )
+        MimeTypes.registerCustomMimeType(
+            MIME_WMA,
+            CODEC_WMAV2,
+            C.TRACK_TYPE_AUDIO,
+        )
+        MimeTypes.registerCustomMimeType(
+            MIME_WMA_V1,
+            CODEC_WMAV1,
+            C.TRACK_TYPE_AUDIO,
+        )
+        MimeTypes.registerCustomMimeType(
+            MIME_WMA_V2,
+            CODEC_WMAV2,
+            C.TRACK_TYPE_AUDIO,
+        )
+        MimeTypes.registerCustomMimeType(
+            MIME_WMA_PRO,
+            CODEC_WMAPRO,
+            C.TRACK_TYPE_AUDIO,
+        )
+        MimeTypes.registerCustomMimeType(
+            MIME_WMA_LOSSLESS,
+            CODEC_WMALOSSLESS,
+            C.TRACK_TYPE_AUDIO,
+        )
+        MimeTypes.registerCustomMimeType(
+            MIME_WMA_VOICE,
+            CODEC_WMAVOICE,
+            C.TRACK_TYPE_AUDIO,
+        )
+    }
+}
