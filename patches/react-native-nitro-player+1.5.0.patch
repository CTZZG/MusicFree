@@ -0,0 +1,30 @@
+package com.margelo.nitro.nitroplayer.musicfree
+
+import android.net.Uri
+import androidx.media3.extractor.Extractor
+import androidx.media3.extractor.ExtractorsFactory
+
+internal class MusicFreeExtractorsFactory(
+    private val delegate: ExtractorsFactory,
+    private val extensionFactories: List<() -> Extractor> = emptyList(),
+) : ExtractorsFactory {
+    override fun createExtractors(): Array<Extractor> =
+        prependExtensionExtractors(delegate.createExtractors())
+
+    override fun createExtractors(
+        uri: Uri,
+        responseHeaders: Map<String, List<String>>,
+    ): Array<Extractor> =
+        prependExtensionExtractors(
+            delegate.createExtractors(uri, responseHeaders),
+        )
+
+    private fun prependExtensionExtractors(
+        delegateExtractors: Array<Extractor>,
+    ): Array<Extractor> {
+        if (extensionFactories.isEmpty()) {
+            return delegateExtractors
+        }
+        return extensionFactories.map { it() }.toTypedArray() + delegateExtractors
+    }
+}
