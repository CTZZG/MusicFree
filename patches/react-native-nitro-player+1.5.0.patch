+)
+
+internal data class AsfWmaPayload(
+    val streamNumber: Int,
+    val encrypted: Boolean,
+    val mediaObjectNumber: Long,
+    val offsetIntoMediaObject: Long,
+    val replicatedData: ByteArray,
+    val mediaObjectSize: Long?,
+    val presentationTimeMs: Long?,
+    val presentationTimeDeltaMs: Long?,
+    val payloadData: ByteArray,
+    val targetAudioStream: Boolean,
+    val compressedPayload: Boolean,
+)
+
+private class AsfPacketCursor(
+    private val data: ByteArray,
+    private val limit: Int,
+) {
+    var position = 0
+        private set
+
+    fun readUnsignedByte(): Int {
+        ensureAvailable(1)
+        return data[position++].toInt() and 0xff
+    }
+
+    fun readLittleEndianUnsignedShort(): Long {
+        ensureAvailable(2)
+        val value =
+            (data[position].toLong() and 0xffL) or
+                ((data[position + 1].toLong() and 0xffL) shl 8)
+        position += 2
+        return value
+    }
+
+    fun readLittleEndianUnsignedInt(): Long {
+        ensureAvailable(4)
+        val value =
+            (data[position].toLong() and 0xffL) or
+                ((data[position + 1].toLong() and 0xffL) shl 8) or
+                ((data[position + 2].toLong() and 0xffL) shl 16) or
+                ((data[position + 3].toLong() and 0xffL) shl 24)
+        position += 4
+        return value
+    }
+
+    fun readVariableLength(type: Int): Long =
+        when (type) {
+            0 -> 0L
+            1 -> readUnsignedByte().toLong()
+            2 -> readLittleEndianUnsignedShort()
+            3 -> readLittleEndianUnsignedInt()
+            else -> throw IOException("Invalid ASF length type.")
+        }
+
+    fun readBytes(size: Int): ByteArray {
+        if (size < 0) {
+            throw IOException("Invalid ASF byte count.")
+        }
+        ensureAvailable(size)
+        val bytes = data.copyOfRange(position, position + size)
+        position += size
+        return bytes
+    }
+
+    fun skip(size: Int) {
+        if (size < 0) {
+            throw IOException("Invalid ASF skip count.")
+        }
+        ensureAvailable(size)
+        position += size
+    }
+
+    private fun ensureAvailable(size: Int) {
+        if (position + size > limit) {
+            throw IOException("Truncated ASF packet.")
+        }
+    }
+}
+
+private fun ByteArray.readLittleEndianUnsignedIntOrNull(offset: Int): Long? {
+    if (size < offset + 4) {
+        return null
+    }
+    return (this[offset].toLong() and 0xffL) or
+        ((this[offset + 1].toLong() and 0xffL) shl 8) or
+        ((this[offset + 2].toLong() and 0xffL) shl 16) or
+        ((this[offset + 3].toLong() and 0xffL) shl 24)
+}
+
+private fun ByteArray.readUnsignedByteOrNull(offset: Int): Long? {
+    if (size <= offset) {
+        return null
+    }
+    return this[offset].toLong() and 0xffL
+}
