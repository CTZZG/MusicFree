+    private fun readFormatChunk(
+        input: ExtractorInput,
+        payloadSize: Long,
+    ): DsfFormat {
+        if (payloadSize < MIN_FMT_PAYLOAD_SIZE) {
+            throw IOException("Invalid DSF fmt chunk.")
+        }
