+      normalized == "localhost" ||
+      normalized.hasSuffix(".localhost") ||
+      normalized.hasSuffix(".local")
+  }
+
+  private static func isBlockedAddress(_ address: UnsafePointer<sockaddr>) -> Bool {
+    switch Int32(address.pointee.sa_family) {
+    case AF_INET:
+      return address.withMemoryRebound(to: sockaddr_in.self, capacity: 1) { pointer in
+        let value = UInt32(bigEndian: pointer.pointee.sin_addr.s_addr)
+        let bytes = [
+          Int((value >> 24) & 0xff),
+          Int((value >> 16) & 0xff),
+          Int((value >> 8) & 0xff),
+          Int(value & 0xff),
+        ]
+        return isBlockedIpv4(bytes)
+      }
+    case AF_INET6:
+      return address.withMemoryRebound(to: sockaddr_in6.self, capacity: 1) { pointer in
+        var value = pointer.pointee.sin6_addr
+        let bytes = withUnsafeBytes(of: &value) { Array($0) }
+        return isBlockedIpv6(bytes)
+      }
+    default:
+      return true
+    }
+  }
+
+  private static func isBlockedIpv4(_ bytes: [Int]) -> Bool {
+    guard bytes.count == 4 else { return true }
+    let a = bytes[0]
+    let b = bytes[1]
+    let c = bytes[2]
+    return a == 0 ||
+      a == 10 ||
+      a == 127 ||
+      (a == 100 && b >= 64 && b <= 127) ||
+      (a == 169 && b == 254) ||
+      (a == 172 && b >= 16 && b <= 31) ||
+      (a == 192 && b == 0 && c == 0) ||
+      (a == 192 && b == 0 && c == 2) ||
+      (a == 192 && b == 88 && c == 99) ||
+      (a == 192 && b == 168) ||
+      (a == 198 && b >= 18 && b <= 19) ||
+      (a == 198 && b == 51 && c == 100) ||
+      (a == 203 && b == 0 && c == 113) ||
+      a >= 224
+  }
+
+  private static func isBlockedIpv6(_ bytes: [UInt8]) -> Bool {
+    guard bytes.count == 16 else { return true }
+    let allZero = bytes.allSatisfy { $0 == 0 }
+    let loopback = bytes.prefix(15).allSatisfy { $0 == 0 } && bytes[15] == 1
+    let uniqueLocal = bytes[0] >= 0xfc && bytes[0] <= 0xfd
+    let linkLocal = bytes[0] == 0xfe && bytes[1] >= 0x80 && bytes[1] <= 0xbf
+    let siteLocal = bytes[0] == 0xfe && bytes[1] >= 0xc0
+    let multicast = bytes[0] == 0xff
+    let documentation =
+      bytes[0] == 0x20 && bytes[1] == 0x01 && bytes[2] == 0x0d && bytes[3] == 0xb8
+    let discardOnly = bytes[0] == 0x01 && bytes.dropFirst().allSatisfy { $0 == 0 }
+    let ipv4Mapped =
+      bytes.prefix(10).allSatisfy { $0 == 0 } && bytes[10] == 0xff && bytes[11] == 0xff
+    let mappedBlocked = ipv4Mapped && isBlockedIpv4(bytes.suffix(4).map(Int.init))
+    return allZero || loopback || uniqueLocal || linkLocal || siteLocal || multicast ||
+      documentation || discardOnly || mappedBlocked
+  }
+
+  private static func mediaError(_ message: String) -> NSError {
+    NSError(
+      domain: "MusicFreeNitroMediaTransport",
+      code: -1,
+      userInfo: [NSLocalizedDescriptionKey: message])
   }
 }
