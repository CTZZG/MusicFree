+
+    override fun read(
+        input: ExtractorInput,
+        seekPosition: PositionHolder,
+    ): Int {
+        if (!headerParsed) {
+            parseHeader(input)
+            headerParsed = true
+        }
+
+        if (dataBytesRemaining <= 0) {
+            return Extractor.RESULT_END_OF_INPUT
+        }
+
+        val bytesToRead = min(bytesPerSampleBlock.toLong(), dataBytesRemaining).toInt()
+        val bytesRead =
+            trackOutput?.sampleData(input, bytesToRead, true)
+                ?: throw IOException("DSF track output is not initialized.")
+
+        if (bytesRead == C.RESULT_END_OF_INPUT) {
+            return Extractor.RESULT_END_OF_INPUT
+        }
+
+        trackOutput?.sampleMetadata(
+            sampleTimeUs,
+            C.BUFFER_FLAG_KEY_FRAME,
+            bytesRead,
+            0,
+            null,
+        )
+        dataBytesRemaining -= bytesRead.toLong()
+        sampleTimeUs += blockDurationUs
+        return Extractor.RESULT_CONTINUE
+    }
+
+    override fun seek(position: Long, timeUs: Long) {
+        if (position == 0L || position < dataStartPosition) {
+            sampleTimeUs = 0L
+            headerParsed = false
+            dataBytesRemaining = 0L
+            return
+        }
+
+        val seekOffset =
+            (position - dataStartPosition)
+                .coerceIn(0L, dataSize)
+                .alignDown(bytesPerSampleBlock.toLong())
+        val blockIndex =
+            if (bytesPerSampleBlock > 0) {
+                seekOffset / bytesPerSampleBlock
+            } else {
+                0L
+            }
+
+        headerParsed = true
+        sampleTimeUs =
+            if (blockDurationUs > 0) {
+                blockIndex * blockDurationUs
+            } else {
+                timeUs
+            }
+        dataBytesRemaining = max(0L, dataSize - seekOffset)
+    }
+
+    override fun release() = Unit
+
+    private fun parseHeader(input: ExtractorInput) {
+        val header = ByteArray(CHUNK_HEADER_SIZE)
