+        var format: DsfFormat? = null
+        while (true) {
+            if (!input.readFully(header, 0, header.size, true)) {
+                throw EOFException("Missing DSF data chunk.")
+            }
+
+            val chunkPayloadSize = payloadSize(header.readLittleEndianLong(4))
+            when {
+                header.matchesAscii("fmt ") -> {
+                    format = readFormatChunk(input, chunkPayloadSize)
+                }
+                header.matchesAscii("data") -> {
+                    val parsedFormat =
+                        format ?: throw IOException("Missing DSF fmt chunk.")
+                    dataStartPosition = input.position
+                    dataSize = chunkPayloadSize
+                    dataBytesRemaining = dataSize
+                    outputFormat(parsedFormat)
+                    return
+                }
+                else -> skipFullyLong(input, chunkPayloadSize)
+            }
+        }
+    }
+
+    private fun readFormatChunk(
+        input: ExtractorInput,
+        payloadSize: Long,
+    ): DsfFormat {
+        if (payloadSize < MIN_FMT_PAYLOAD_SIZE) {
+            throw IOException("Invalid DSF fmt chunk.")
+        }
+
+        val payload = ByteArray(payloadSize.toInt())
+        input.readFully(payload, 0, payload.size)
+        val channelCount = payload.readLittleEndianInt(12)
+        val sampleRate = payload.readLittleEndianInt(16)
+        val bitsPerSample = payload.readLittleEndianInt(20)
+        val sampleCount = payload.readLittleEndianLong(24)
+        val blockSizePerChannel = payload.readLittleEndianInt(32)
+
+        if (
+            channelCount <= 0 ||
+            sampleRate <= 0 ||
+            bitsPerSample <= 0 ||
+            blockSizePerChannel <= 0
+        ) {
+            throw IOException("Unsupported DSF fmt values.")
+        }
+
+        return DsfFormat(
+            channelCount = channelCount,
+            sampleRate = sampleRate,
+            bitsPerSample = bitsPerSample,
+            sampleCount = sampleCount,
+            blockSizePerChannel = blockSizePerChannel,
+            initializationData = payload,
+        )
+    }
+
+    private fun outputFormat(format: DsfFormat) {
+        bytesPerSampleBlock =
+            max(
+                1,
+                format.blockSizePerChannel * format.channelCount,
+            )
+        val samplesPerBlock =
+            (format.blockSizePerChannel.toLong() * BITS_PER_BYTE) /
+                format.bitsPerSample
+        blockDurationUs =
+            max(1L, (samplesPerBlock * C.MICROS_PER_SECOND) / format.sampleRate)
+
+        durationUs =
+            if (format.sampleCount > 0) {
+                (format.sampleCount * C.MICROS_PER_SECOND) / format.sampleRate
+            } else {
+                C.TIME_UNSET
+            }
+
+        extractorOutput?.seekMap(
+            if (
+                durationUs != C.TIME_UNSET &&
+                dataSize > 0 &&
+                bytesPerSampleBlock > 0 &&
+                blockDurationUs > 0
+            ) {
+                DsfSeekMap(
+                    durationUs = durationUs,
+                    dataStartPosition = dataStartPosition,
+                    dataSize = dataSize,
+                    bytesPerSampleBlock = bytesPerSampleBlock,
+                    blockDurationUs = blockDurationUs,
+                )
+            } else {
+                SeekMap.Unseekable(durationUs)
+            },
+        )
+        trackOutput?.durationUs(durationUs)
+        trackOutput?.format(
+            Format.Builder()
+                .setContainerMimeType(MusicFreeAudioFormatRegistry.MIME_DSF)
+                .setSampleMimeType(MusicFreeAudioFormatRegistry.MIME_DSF)
+                .setCodecs(MusicFreeAudioFormatRegistry.CODEC_DSF)
+                .setChannelCount(format.channelCount)
+                .setSampleRate(format.decoderSampleRate)
+                .setMaxInputSize(max(DEFAULT_MAX_INPUT_SIZE, bytesPerSampleBlock))
+                .setInitializationData(listOf(format.initializationData))
+                .build(),
+        )
+    }
+
+    private fun payloadSize(chunkSize: Long): Long =
+        if (chunkSize >= CHUNK_HEADER_SIZE) {
+            chunkSize - CHUNK_HEADER_SIZE
+        } else {
+            throw IOException("Invalid DSF chunk size.")
+        }
+
+    private fun skipFullyLong(input: ExtractorInput, bytes: Long) {
+        var remaining = bytes
+        while (remaining > 0) {
+            val step = min(remaining, Int.MAX_VALUE.toLong()).toInt()
+            input.skipFully(step)
+            remaining -= step.toLong()
+        }
+    }
+
+    private data class DsfFormat(
+        val channelCount: Int,
+        val sampleRate: Int,
+        val bitsPerSample: Int,
+        val sampleCount: Long,
+        val blockSizePerChannel: Int,
+        val initializationData: ByteArray,
+    ) {
+        val decoderSampleRate: Int = max(1, sampleRate / BITS_PER_BYTE)
+    }
+
+    private class DsfSeekMap(
+        private val durationUs: Long,
+        private val dataStartPosition: Long,
+        dataSize: Long,
+        private val bytesPerSampleBlock: Int,
+        private val blockDurationUs: Long,
+    ) : SeekMap {
+        private val maxBlockIndex =
+            if (dataSize > 0 && bytesPerSampleBlock > 0) {
+                (dataSize - 1L) / bytesPerSampleBlock
+            } else {
+                0L
+            }
+
+        override fun isSeekable(): Boolean = true
+
+        override fun getDurationUs(): Long = durationUs
+
+        override fun getSeekPoints(timeUs: Long): SeekMap.SeekPoints {
+            val blockIndex =
+                if (blockDurationUs > 0) {
+                    (timeUs / blockDurationUs).coerceIn(0L, maxBlockIndex)
+                } else {
+                    0L
+                }
+            val first = seekPoint(blockIndex)
+            if (first.timeUs >= timeUs || blockIndex == maxBlockIndex) {
+                return SeekMap.SeekPoints(first)
+            }
+            return SeekMap.SeekPoints(first, seekPoint(blockIndex + 1))
+        }
+
+        private fun seekPoint(blockIndex: Long): SeekPoint {
+            val offset = blockIndex * bytesPerSampleBlock
+            return SeekPoint(
+                blockIndex * blockDurationUs,
+                dataStartPosition + offset,
+            )
+        }
+    }
+
+    private companion object {
+        private const val CHUNK_HEADER_SIZE = 12
+        private const val MIN_FMT_PAYLOAD_SIZE = 40L
+        private const val DEFAULT_MAX_INPUT_SIZE = 8192
+        private const val BITS_PER_BYTE = 8
+    }
+}
+
+private fun ByteArray.matchesAscii(value: String): Boolean {
+    if (size < value.length) {
+        return false
+    }
+    for (index in value.indices) {
+        if (this[index].toInt().toChar() != value[index]) {
+            return false
+        }
+    }
+    return true
+}
+
+private fun ByteArray.toHex(): String =
+    joinToString(" ") { byte -> "%02x".format(byte.toInt() and 0xff) }
+
+private fun ByteArray.readLittleEndianInt(offset: Int): Int =
+    (this[offset].toInt() and 0xff) or
+        ((this[offset + 1].toInt() and 0xff) shl 8) or
+        ((this[offset + 2].toInt() and 0xff) shl 16) or
+        ((this[offset + 3].toInt() and 0xff) shl 24)
+
+private fun ByteArray.readLittleEndianLong(offset: Int): Long =
+    (this[offset].toLong() and 0xffL) or
+        ((this[offset + 1].toLong() and 0xffL) shl 8) or
+        ((this[offset + 2].toLong() and 0xffL) shl 16) or
+        ((this[offset + 3].toLong() and 0xffL) shl 24) or
+        ((this[offset + 4].toLong() and 0xffL) shl 32) or
+        ((this[offset + 5].toLong() and 0xffL) shl 40) or
+        ((this[offset + 6].toLong() and 0xffL) shl 48) or
+        ((this[offset + 7].toLong() and 0xffL) shl 56)
+
+private fun Long.alignDown(blockSize: Long): Long =
+    if (blockSize > 0) {
+        (this / blockSize) * blockSize
+    } else {
+        this
+    }
