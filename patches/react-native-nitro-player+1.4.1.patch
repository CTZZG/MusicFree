+package com.margelo.nitro.nitroplayer.musicfree
+
+import java.io.ByteArrayOutputStream
+import java.io.IOException
+import kotlin.math.max
+
+internal class AsfWmaPayloadAssembler(
+    private val audioStreamNumber: Int,
+) {
+    private val pendingMediaObjects = mutableMapOf<Long, PendingMediaObject>()
+
+    fun consume(packet: AsfWmaPacket): List<AsfWmaSample> {
+        val samples = mutableListOf<AsfWmaSample>()
+        for (payload in packet.payloads) {
+            if (!payload.targetAudioStream) {
+                continue
+            }
+            if (payload.encrypted) {
+                throw IOException("Encrypted ASF/WMA payloads are not supported.")
+            }
+
+            if (payload.compressedPayload) {
+                samples += consumeCompressedPayload(packet, payload)
+            } else {
+                consumeStandardPayload(packet, payload)?.let(samples::add)
+            }
+        }
+        return samples
+    }
+
+    fun reset() {
+        pendingMediaObjects.clear()
+    }
+
+    private fun consumeStandardPayload(
+        packet: AsfWmaPacket,
+        payload: AsfWmaPayload,
+    ): AsfWmaSample? {
+        val mediaObjectSize =
+            payload.mediaObjectSize
+                ?: return AsfWmaSample(
+                    timeUs = toTimeUs(payload.presentationTimeMs ?: packet.sendTimeMs),
+                    mediaObjectNumber = payload.mediaObjectNumber,
+                    data = payload.payloadData,
+                    compressedPayload = false,
+                )
+        if (mediaObjectSize <= 0 || mediaObjectSize > Int.MAX_VALUE) {
+            throw IOException("Invalid ASF/WMA media object size.")
+        }
+
+        val pending =
+            if (payload.offsetIntoMediaObject == 0L) {
+                PendingMediaObject(
+                    mediaObjectNumber = payload.mediaObjectNumber,
+                    expectedSize = mediaObjectSize.toInt(),
+                    timeUs = toTimeUs(payload.presentationTimeMs ?: packet.sendTimeMs),
+                ).also { pendingMediaObjects[payload.mediaObjectNumber] = it }
+            } else {
+                pendingMediaObjects[payload.mediaObjectNumber]
+                    ?: throw IOException("Missing initial ASF/WMA media object fragment.")
+            }
+
+        if (payload.offsetIntoMediaObject != pending.size.toLong()) {
+            throw IOException("Non-sequential ASF/WMA media object fragments are not supported.")
+        }
+        pending.append(payload.payloadData)
+        if (!pending.complete) {
+            return null
+        }
+
+        pendingMediaObjects.remove(payload.mediaObjectNumber)
+        return AsfWmaSample(
+            timeUs = pending.timeUs,
+            mediaObjectNumber = pending.mediaObjectNumber,
+            data = pending.bytes(),
+            compressedPayload = false,
+        )
+    }
+
+    private fun consumeCompressedPayload(
+        packet: AsfWmaPacket,
+        payload: AsfWmaPayload,
+    ): List<AsfWmaSample> {
+        val presentationTimeDeltaMs =
+            payload.presentationTimeDeltaMs
+                ?: throw IOException("Missing ASF/WMA compressed payload time delta.")
+        val basePresentationTimeMs = payload.offsetIntoMediaObject
+        val samples = mutableListOf<AsfWmaSample>()
+        var position = 0
+        var subPayloadIndex = 0
+        while (position < payload.payloadData.size) {
+            val subPayloadSize = payload.payloadData[position].toInt() and 0xff
+            position += 1
+            if (subPayloadSize <= 0 || position + subPayloadSize > payload.payloadData.size) {
+                throw IOException("Invalid ASF/WMA compressed sub-payload size.")
+            }
+            val timeMs =
+                basePresentationTimeMs +
+                    (presentationTimeDeltaMs * subPayloadIndex.toLong())
+            samples.add(
+                AsfWmaSample(
+                    timeUs = toTimeUs(timeMs.takeIf { it > 0 } ?: packet.sendTimeMs),
+                    mediaObjectNumber = payload.mediaObjectNumber + subPayloadIndex,
+                    data = payload.payloadData.copyOfRange(position, position + subPayloadSize),
+                    compressedPayload = true,
+                ),
+            )
+            position += subPayloadSize
+            subPayloadIndex += 1
+        }
+        return samples
+    }
+
+    private fun toTimeUs(timeMs: Long): Long = max(0L, timeMs * 1000L)
+
+    private class PendingMediaObject(
+        val mediaObjectNumber: Long,
+        private val expectedSize: Int,
+        val timeUs: Long,
+    ) {
+        private val data = ByteArrayOutputStream(expectedSize)
+
+        val size: Int
+            get() = data.size()
+
+        val complete: Boolean
+            get() = size == expectedSize
+
+        fun append(bytes: ByteArray) {
+            if (size + bytes.size > expectedSize) {
+                throw IOException("ASF/WMA media object fragment exceeds expected size.")
+            }
+            data.write(bytes, 0, bytes.size)
+        }
+
+        fun bytes(): ByteArray {
+            if (!complete) {
+                throw IOException("Incomplete ASF/WMA media object.")
+            }
+            return data.toByteArray()
+        }
+    }
+}
+
+internal data class AsfWmaSample(
+    val timeUs: Long,
+    val mediaObjectNumber: Long,
+    val data: ByteArray,
+    val compressedPayload: Boolean,
+)
