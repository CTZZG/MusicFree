+package com.margelo.nitro.nitroplayer.musicfree
+
+import androidx.media3.common.C
+import androidx.media3.common.Format
+import androidx.media3.common.util.ParsableByteArray
+import androidx.media3.extractor.Extractor
+import androidx.media3.extractor.ExtractorInput
+import androidx.media3.extractor.ExtractorOutput
+import androidx.media3.extractor.PositionHolder
+import androidx.media3.extractor.SeekMap
+import androidx.media3.extractor.SeekPoint
+import androidx.media3.extractor.TrackOutput
+import java.io.IOException
+import kotlin.math.max
+
+internal class AsfWmaExtractor : Extractor {
+    private var extractorOutput: ExtractorOutput? = null
+    private var trackOutput: TrackOutput? = null
+    private var header: AsfWmaHeader? = null
+    private var audioStream: AsfWmaAudioStream? = null
+    private var assembler: AsfWmaPayloadAssembler? = null
+    private var packetSize = 0
+    private var totalPacketCount = UNKNOWN_PACKET_COUNT
+    private var packetsRemaining = 0L
+    private var dataStartPosition = 0L
+    private var headerParsed = false
+
+    override fun sniff(input: ExtractorInput): Boolean {
+        val objectHeader = ByteArray(ASF_OBJECT_HEADER_SIZE)
+        val ok = input.peekFully(objectHeader, 0, objectHeader.size, true)
+        input.resetPeekPosition()
+        return ok && AsfWmaHeaderParser.sniff(objectHeader)
+    }
+
+    override fun init(output: ExtractorOutput) {
+        extractorOutput = output
+        trackOutput = output.track(0, C.TRACK_TYPE_AUDIO)
+        output.endTracks()
+    }
+
+    override fun read(
+        input: ExtractorInput,
+        seekPosition: PositionHolder,
+    ): Int {
+        if (!headerParsed) {
+            parseHeaders(input)
+            headerParsed = true
+        }
+
+        if (packetsRemaining == 0L) {
+            return Extractor.RESULT_END_OF_INPUT
+        }
+
+        val packet = ByteArray(packetSize)
+        val ok = input.readFully(packet, 0, packet.size, true)
+        if (!ok) {
+            return Extractor.RESULT_END_OF_INPUT
+        }
+        if (packetsRemaining > 0) {
+            packetsRemaining -= 1
+        }
+
+        val parsedPacket =
+            AsfWmaPacketParser.parse(
+                packet = packet,
+                declaredPacketSize = packetSize,
+                audioStreamNumber =
+                    audioStream?.streamNumber
+                        ?: throw IOException("Missing ASF/WMA audio stream."),
+            )
+        val samples =
+            assembler
+                ?.consume(parsedPacket)
+                ?: throw IOException("ASF/WMA payload assembler is not initialized.")
+
+        for (sample in samples) {
+            outputSample(sample)
+        }
+        return Extractor.RESULT_CONTINUE
+    }
+
+    override fun seek(position: Long, timeUs: Long) {
+        if (position == 0L) {
+            headerParsed = false
+            packetsRemaining = 0L
+            assembler?.reset()
+            return
+        }
+
+        val packetIndex =
+            if (dataStartPosition > 0 && packetSize > 0 && position >= dataStartPosition) {
+                ((position - dataStartPosition) / packetSize)
+                    .coerceAtLeast(0L)
+            } else {
+                0L
+            }
+        assembler?.reset()
+        packetsRemaining =
+            if (totalPacketCount > 0) {
+                (totalPacketCount - packetIndex).coerceAtLeast(0L)
+            } else {
+                UNKNOWN_PACKET_COUNT
+            }
+        if (header != null && audioStream != null) {
+            headerParsed = true
+        }
+    }
+
+    override fun release() = Unit
+
+    private fun parseHeaders(input: ExtractorInput) {
+        val objectHeader = ByteArray(ASF_OBJECT_HEADER_SIZE)
+        input.readFully(objectHeader, 0, objectHeader.size)
+        if (!AsfWmaHeaderParser.sniff(objectHeader)) {
+            throw IOException("Invalid ASF/WMA header object.")
+        }
+
+        val headerSize = objectHeader.readLittleEndianLong(16)
+        if (headerSize < ASF_HEADER_MIN_SIZE || headerSize > Int.MAX_VALUE) {
+            throw IOException("Invalid ASF/WMA header size.")
+        }
+        val headerBytes = ByteArray(headerSize.toInt())
+        objectHeader.copyInto(headerBytes)
+        input.readFully(headerBytes, objectHeader.size, headerBytes.size - objectHeader.size)
+
+        val parsedHeader = AsfWmaHeaderParser.parse(headerBytes)
+        val parsedAudioStream =
+            parsedHeader.audioStream ?: throw IOException("Missing ASF/WMA audio stream.")
+        if (parsedHeader.packetSize <= 0) {
+            throw IOException("Invalid ASF/WMA packet size.")
+        }
+
+        val dataObjectHeader = ByteArray(ASF_DATA_OBJECT_HEADER_SIZE)
+        input.readFully(dataObjectHeader, 0, dataObjectHeader.size)
+        val dataObject = AsfWmaHeaderParser.parseDataObject(dataObjectHeader)
+
+        header = parsedHeader
+        audioStream = parsedAudioStream
+        packetSize = parsedHeader.packetSize
+        totalPacketCount =
+            when {
+                dataObject.packetCount > 0 -> dataObject.packetCount
+                parsedHeader.packetCount > 0 -> parsedHeader.packetCount
+                else -> UNKNOWN_PACKET_COUNT
+            }
+        packetsRemaining = totalPacketCount
+        dataStartPosition = input.position
+        assembler = AsfWmaPayloadAssembler(parsedAudioStream.streamNumber)
+        outputFormat(parsedHeader, parsedAudioStream)
+    }
+
+    private fun outputFormat(
+        parsedHeader: AsfWmaHeader,
+        parsedAudioStream: AsfWmaAudioStream,
+    ) {
+        val durationUs =
+            if (parsedHeader.durationUs > 0) {
+                parsedHeader.durationUs
+            } else {
+                C.TIME_UNSET
+            }
+        extractorOutput?.seekMap(
+            if (
+                durationUs != C.TIME_UNSET &&
+                dataStartPosition > 0 &&
+                packetSize > 0 &&
+                totalPacketCount > 0
+            ) {
+                AsfWmaSeekMap(
+                    durationUs = durationUs,
+                    dataStartPosition = dataStartPosition,
+                    packetSize = packetSize,
+                    packetCount = totalPacketCount,
+                )
+            } else {
+                SeekMap.Unseekable(durationUs)
+            },
+        )
+        trackOutput?.durationUs(durationUs)
+        trackOutput?.format(
+            Format.Builder()
+                .setContainerMimeType(MusicFreeAudioFormatRegistry.MIME_WMA)
+                .setSampleMimeType(parsedAudioStream.sampleMimeType)
+                .setCodecs(parsedAudioStream.codecName)
+                .setChannelCount(parsedAudioStream.channelCount)
+                .setSampleRate(parsedAudioStream.sampleRate)
+                .setAverageBitrate(max(0, parsedAudioStream.averageBytesPerSecond) * BITS_PER_BYTE)
+                .setMaxInputSize(max(DEFAULT_MAX_INPUT_SIZE, packetSize))
+                .setInitializationData(listOf(parsedAudioStream.codecSpecificData))
+                .build(),
+        )
+    }
+
+    private class AsfWmaSeekMap(
+        private val durationUs: Long,
+        private val dataStartPosition: Long,
+        private val packetSize: Int,
+        packetCount: Long,
+    ) : SeekMap {
+        private val maxPacketIndex = (packetCount - 1L).coerceAtLeast(0L)
+
+        override fun isSeekable(): Boolean = true
+
+        override fun getDurationUs(): Long = durationUs
+
+        override fun getSeekPoints(timeUs: Long): SeekMap.SeekPoints {
+            val packetIndex =
+                ((timeUs.coerceIn(0L, durationUs) * (maxPacketIndex + 1L)) / durationUs)
+                    .coerceIn(0L, maxPacketIndex)
+            val first = seekPoint(packetIndex)
+            if (first.timeUs >= timeUs || packetIndex == maxPacketIndex) {
+                return SeekMap.SeekPoints(first)
+            }
+            return SeekMap.SeekPoints(first, seekPoint(packetIndex + 1L))
+        }
+
+        private fun seekPoint(packetIndex: Long): SeekPoint {
+            val packetDurationUs = durationUs / (maxPacketIndex + 1L)
+            return SeekPoint(
+                packetIndex * packetDurationUs,
+                dataStartPosition + (packetIndex * packetSize),
+            )
+        }
+    }
+
+    private fun outputSample(sample: AsfWmaSample) {
+        val bytes = ParsableByteArray(sample.data)
+        trackOutput?.sampleData(bytes, sample.data.size)
+        trackOutput?.sampleMetadata(
+            sample.timeUs,
+            C.BUFFER_FLAG_KEY_FRAME,
+            sample.data.size,
+            0,
+            null,
+        )
+    }
+
+    private companion object {
+        private const val ASF_OBJECT_HEADER_SIZE = 24
+        private const val ASF_HEADER_MIN_SIZE = 30
+        private const val ASF_DATA_OBJECT_HEADER_SIZE = 50
+        private const val DEFAULT_MAX_INPUT_SIZE = 8192
+        private const val BITS_PER_BYTE = 8
+        private const val UNKNOWN_PACKET_COUNT = -1L
+    }
+}
+
+private fun ByteArray.readLittleEndianLong(offset: Int): Long =
+    (this[offset].toLong() and 0xffL) or
+        ((this[offset + 1].toLong() and 0xffL) shl 8) or
+        ((this[offset + 2].toLong() and 0xffL) shl 16) or
+        ((this[offset + 3].toLong() and 0xffL) shl 24) or
+        ((this[offset + 4].toLong() and 0xffL) shl 32) or
+        ((this[offset + 5].toLong() and 0xffL) shl 40) or
+        ((this[offset + 6].toLong() and 0xffL) shl 48) or
+        ((this[offset + 7].toLong() and 0xffL) shl 56)
