+
+internal class DsfExtractor : Extractor {
+    private var extractorOutput: ExtractorOutput? = null
+    private var trackOutput: TrackOutput? = null
+    private var headerParsed = false
+    private var dataBytesRemaining = 0L
+    private var dataSize = 0L
+    private var dataStartPosition = 0L
+    private var durationUs = C.TIME_UNSET
+    private var sampleTimeUs = 0L
+    private var bytesPerSampleBlock = DEFAULT_MAX_INPUT_SIZE
+    private var blockDurationUs = 0L
+    private var sniffedDsdChunkHeader: ByteArray? = null
+
+    override fun sniff(input: ExtractorInput): Boolean {
+        val header = ByteArray(CHUNK_HEADER_SIZE)
+        val ok = input.peekFully(header, 0, header.size, true)
+        input.resetPeekPosition()
+        sniffedDsdChunkHeader = if (ok && header.matchesAscii("DSD ")) header else null
+        return sniffedDsdChunkHeader != null
+    }
+
+    override fun init(output: ExtractorOutput) {
+        extractorOutput = output
+        trackOutput = output.track(0, C.TRACK_TYPE_AUDIO)
+        output.endTracks()
+    }
+
+    override fun read(
+        input: ExtractorInput,
+        seekPosition: PositionHolder,
+    ): Int {
+        if (!headerParsed) {
+            parseHeader(input)
+            headerParsed = true
+        }
+
+        if (dataBytesRemaining <= 0) {
+            return Extractor.RESULT_END_OF_INPUT
+        }
+
+        val bytesToRead = min(bytesPerSampleBlock.toLong(), dataBytesRemaining).toInt()
+        val bytesRead =
+            trackOutput?.sampleData(input, bytesToRead, true)
+                ?: throw IOException("DSF track output is not initialized.")
+
+        if (bytesRead == C.RESULT_END_OF_INPUT) {
+            return Extractor.RESULT_END_OF_INPUT
+        }
+
+        trackOutput?.sampleMetadata(
+            sampleTimeUs,
+            C.BUFFER_FLAG_KEY_FRAME,
+            bytesRead,
+            0,
+            null,
+        )
+        dataBytesRemaining -= bytesRead.toLong()
+        sampleTimeUs += blockDurationUs
+        return Extractor.RESULT_CONTINUE
+    }
+
+    override fun seek(position: Long, timeUs: Long) {
+        if (position == 0L || position < dataStartPosition) {
+            sampleTimeUs = 0L
+            headerParsed = false
+            dataBytesRemaining = 0L
+            return
+        }
+
+        val seekOffset =
+            (position - dataStartPosition)
+                .coerceIn(0L, dataSize)
+                .alignDown(bytesPerSampleBlock.toLong())
+        val blockIndex =
+            if (bytesPerSampleBlock > 0) {
+                seekOffset / bytesPerSampleBlock
+            } else {
+                0L
+            }
+
+        headerParsed = true
+        sampleTimeUs =
+            if (blockDurationUs > 0) {
+                blockIndex * blockDurationUs
+            } else {
+                timeUs
+            }
+        dataBytesRemaining = max(0L, dataSize - seekOffset)
+    }
+
+    override fun release() = Unit
+
+    private fun parseHeader(input: ExtractorInput) {
+        val header = ByteArray(CHUNK_HEADER_SIZE)
+        input.readFully(header, 0, header.size)
+        val dsdHeader =
+            if (header.matchesAscii("DSD ")) {
+                header
+            } else {
+                sniffedDsdChunkHeader
+                    ?: throw IOException(
+                        "Invalid DSF header at ${input.position - header.size}: ${header.toHex()}",
+                    )
+            }
+        val dsdChunkSize = dsdHeader.readLittleEndianLong(4)
+        if (header.matchesAscii("DSD ")) {
+            skipFullyLong(input, payloadSize(dsdChunkSize))
+        } else {
+            val bytesToFirstChunkEnd = dsdChunkSize - input.position
+            if (bytesToFirstChunkEnd < 0) {
+                throw IOException(
+                    "Invalid DSF input position ${input.position} after sniffed header ${dsdHeader.toHex()}",
+                )
+            }
+            skipFullyLong(input, bytesToFirstChunkEnd)
+        }
