+package com.margelo.nitro.nitroplayer.musicfree
+
+import java.io.IOException
+import kotlin.math.max
+
+internal object AsfWmaHeaderParser {
+    fun sniff(data: ByteArray): Boolean =
+        data.size >= ASF_OBJECT_HEADER_SIZE &&
+            AsfGuid.read(data, 0) == ASF_HEADER_OBJECT
+
+    fun sniffDataObject(data: ByteArray): Boolean =
+        data.size >= ASF_OBJECT_HEADER_SIZE &&
+            AsfGuid.read(data, 0) == ASF_DATA_OBJECT
+
+    fun parse(data: ByteArray): AsfWmaHeader {
+        if (!sniff(data)) {
+            throw IOException("Invalid ASF header.")
+        }
+
+        val headerSize = data.readLittleEndianLong(16)
+        if (headerSize < ASF_HEADER_MIN_SIZE || headerSize > data.size) {
+            throw IOException("Invalid ASF header size.")
+        }
+
+        val objectCount = data.readLittleEndianInt(24)
+        var position = ASF_HEADER_MIN_SIZE
+        var durationUs = 0L
+        var packetSize = 0
+        var packetCount = 0L
+        var audioStream: AsfWmaAudioStream? = null
+
+        repeat(objectCount) {
+            if (position + ASF_OBJECT_HEADER_SIZE > headerSize) {
+                throw IOException("Truncated ASF object header.")
+            }
+
+            val guid = AsfGuid.read(data, position)
+            val objectSize = data.readLittleEndianLong(position + 16)
+            if (
+                objectSize < ASF_OBJECT_HEADER_SIZE ||
+                position + objectSize > headerSize
+            ) {
+                throw IOException("Invalid ASF object size.")
+            }
+
+            val payloadOffset = position + ASF_OBJECT_HEADER_SIZE
+            val payloadSize = (objectSize - ASF_OBJECT_HEADER_SIZE).toInt()
+            when (guid) {
+                ASF_FILE_PROPERTIES_OBJECT -> {
+                    val fileProperties =
+                        parseFileProperties(data, payloadOffset, payloadSize)
+                    durationUs = fileProperties.durationUs
+                    packetSize = fileProperties.packetSize
+                    packetCount = fileProperties.packetCount
+                }
+                ASF_STREAM_PROPERTIES_OBJECT -> {
+                    if (audioStream == null) {
+                        audioStream =
+                            parseAudioStream(data, payloadOffset, payloadSize)
+                    }
+                }
+            }
+
+            position += objectSize.toInt()
+        }
+
+        return AsfWmaHeader(
+            headerSize = headerSize,
+            durationUs = durationUs,
+            packetSize = packetSize,
+            packetCount = packetCount,
+            audioStream = audioStream,
+        )
+    }
+
+    fun parseDataObject(data: ByteArray): AsfWmaDataObject {
+        if (!sniffDataObject(data)) {
+            throw IOException("Invalid ASF data object.")
+        }
+        if (data.size < ASF_DATA_OBJECT_HEADER_SIZE) {
+            throw IOException("Truncated ASF data object header.")
+        }
+
+        val objectSize = data.readLittleEndianLong(16)
+        if (objectSize < ASF_DATA_OBJECT_HEADER_SIZE) {
+            throw IOException("Invalid ASF data object size.")
+        }
+
+        return AsfWmaDataObject(
+            objectSize = objectSize,
+            packetCount = data.readLittleEndianLong(40),
+            firstPacketOffset = ASF_DATA_OBJECT_HEADER_SIZE,
+        )
+    }
+
+    private fun parseFileProperties(
+        data: ByteArray,
+        offset: Int,
+        payloadSize: Int,
+    ): AsfFileProperties {
+        if (payloadSize < ASF_FILE_PROPERTIES_MIN_SIZE) {
+            throw IOException("Invalid ASF file properties object.")
+        }
+
+        val playDuration100Ns = data.readLittleEndianLong(offset + 40)
+        val packetCount = data.readLittleEndianLong(offset + 32)
+        val prerollMs = data.readLittleEndianLong(offset + 56)
+        val minPacketSize = data.readLittleEndianInt(offset + 68)
+        val maxPacketSize = data.readLittleEndianInt(offset + 72)
+        val packetSize =
+            if (minPacketSize == maxPacketSize) {
+                minPacketSize
+            } else {
+                max(minPacketSize, maxPacketSize)
+            }
+        val durationUs =
+            max(0L, (playDuration100Ns / HUNDRED_NS_PER_MICROSECOND) - (prerollMs * 1000L))
+
+        return AsfFileProperties(
+            durationUs = durationUs,
+            packetSize = packetSize,
+            packetCount = packetCount,
+        )
+    }
+
+    private fun parseAudioStream(
+        data: ByteArray,
+        offset: Int,
+        payloadSize: Int,
+    ): AsfWmaAudioStream? {
+        if (payloadSize < ASF_STREAM_PROPERTIES_MIN_SIZE) {
+            throw IOException("Invalid ASF stream properties object.")
+        }
+
+        val streamType = AsfGuid.read(data, offset)
+        if (streamType != ASF_AUDIO_MEDIA) {
+            return null
+        }
+
+        val typeSpecificDataLength = data.readLittleEndianInt(offset + 40)
+        val streamFlags = data.readLittleEndianShort(offset + 48)
+        val streamNumber = streamFlags and ASF_STREAM_NUMBER_MASK
+        val waveFormatOffset = offset + ASF_STREAM_PROPERTIES_MIN_SIZE
+        if (
+            typeSpecificDataLength < WAVE_FORMAT_EX_MIN_SIZE ||
+            waveFormatOffset + typeSpecificDataLength > offset + payloadSize
+        ) {
+            throw IOException("Invalid ASF audio stream format.")
+        }
+
+        val codecId = data.readLittleEndianShort(waveFormatOffset)
+        val channelCount = data.readLittleEndianShort(waveFormatOffset + 2)
+        val sampleRate = data.readLittleEndianInt(waveFormatOffset + 4)
+        val averageBytesPerSecond = data.readLittleEndianInt(waveFormatOffset + 8)
+        val blockAlign = data.readLittleEndianShort(waveFormatOffset + 12)
+        val bitsPerSample = data.readLittleEndianShort(waveFormatOffset + 14)
+        val extraDataSize =
+            if (typeSpecificDataLength >= WAVE_FORMAT_EX_MIN_SIZE) {
+                data.readLittleEndianShort(waveFormatOffset + 16)
+            } else {
+                0
+            }
+        val extraDataOffset = waveFormatOffset + WAVE_FORMAT_EX_MIN_SIZE
+        val safeExtraDataSize =
+            extraDataSize.coerceAtMost(
+                max(0, typeSpecificDataLength - WAVE_FORMAT_EX_MIN_SIZE),
+            )
+        val waveFormatExData =
+            data.copyOfRange(
+                waveFormatOffset,
+                extraDataOffset + safeExtraDataSize,
+            )
+        val codecFormat = AsfWmaCodecFormat.fromWaveFormatCodecId(codecId)
+
+        return AsfWmaAudioStream(
+            streamNumber = streamNumber,
+            codecId = codecId,
+            sampleMimeType = codecFormat.sampleMimeType,
+            codecName = codecFormat.codecName,
+            recognizedCodec = codecFormat.recognized,
+            channelCount = channelCount,
+            sampleRate = sampleRate,
+            averageBytesPerSecond = averageBytesPerSecond,
+            blockAlign = blockAlign,
+            bitsPerSample = bitsPerSample,
+            codecSpecificData = waveFormatExData,
+        )
+    }
+
+    private const val ASF_OBJECT_HEADER_SIZE = 24
+    private const val ASF_HEADER_MIN_SIZE = 30
+    private const val ASF_FILE_PROPERTIES_MIN_SIZE = 80
+    private const val ASF_STREAM_PROPERTIES_MIN_SIZE = 54
+    private const val ASF_DATA_OBJECT_HEADER_SIZE = 50
