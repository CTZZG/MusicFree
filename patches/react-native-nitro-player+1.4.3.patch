+        header = parsedHeader
+        audioStream = parsedAudioStream
+        packetSize = parsedHeader.packetSize
+        totalPacketCount =
+            when {
+                dataObject.packetCount > 0 -> dataObject.packetCount
+                parsedHeader.packetCount > 0 -> parsedHeader.packetCount
+                else -> UNKNOWN_PACKET_COUNT
+            }
+        packetsRemaining = totalPacketCount
+        dataStartPosition = input.position
+        assembler = AsfWmaPayloadAssembler(parsedAudioStream.streamNumber)
+        outputFormat(parsedHeader, parsedAudioStream)
+    }
+
+    private fun outputFormat(
+        parsedHeader: AsfWmaHeader,
+        parsedAudioStream: AsfWmaAudioStream,
+    ) {
+        val durationUs =
+            if (parsedHeader.durationUs > 0) {
+                parsedHeader.durationUs
+            } else {
+                C.TIME_UNSET
+            }
