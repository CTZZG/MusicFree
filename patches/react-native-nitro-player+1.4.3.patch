+        val packetIndex =
+            if (dataStartPosition > 0 && packetSize > 0 && position >= dataStartPosition) {
+                ((position - dataStartPosition) / packetSize)
+                    .coerceAtLeast(0L)
+            } else {
+                0L
+            }
+        assembler?.reset()
+        packetsRemaining =
+            if (totalPacketCount > 0) {
+                (totalPacketCount - packetIndex).coerceAtLeast(0L)
+            } else {
+                UNKNOWN_PACKET_COUNT
+            }
+        if (header != null && audioStream != null) {
+            headerParsed = true
+        }
+    }
+
+    override fun release() = Unit
+
+    private fun parseHeaders(input: ExtractorInput) {
+        val objectHeader = ByteArray(ASF_OBJECT_HEADER_SIZE)
+        input.readFully(objectHeader, 0, objectHeader.size)
+        if (!AsfWmaHeaderParser.sniff(objectHeader)) {
+            throw IOException("Invalid ASF/WMA header object.")
+        }
+
+        val headerSize = objectHeader.readLittleEndianLong(16)
+        if (headerSize < ASF_HEADER_MIN_SIZE || headerSize > Int.MAX_VALUE) {
+            throw IOException("Invalid ASF/WMA header size.")
+        }
+        val headerBytes = ByteArray(headerSize.toInt())
+        objectHeader.copyInto(headerBytes)
+        input.readFully(headerBytes, objectHeader.size, headerBytes.size - objectHeader.size)
